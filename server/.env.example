# Dirección https de la billetera COP de la tienda
WALLET_ADDRESS_URL=

# Identificador de la llave de la tienda
KEY_ID=

# PEM de la llave privada de la tienda, o ruta a un archivo existente
TEST_KEY=

# Dirección https de la billetera USD del operador
WALLET_ADDRESS_URL_VENDEDOR=

# Identificador de la llave del operador
KEY_ID_VENDEDOR=

# PEM de la llave privada del operador, o ruta a un archivo existente
TEST_KEY_VENDEDOR=

# Semilla secreta Stellar del operador en testnet
STELLAR_OPERATOR_SECRET=

# URL de Horizon en testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Emisor de USDC en Stellar testnet
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Puerto HTTP
PORT=3000

# URL pública de este servidor
PUBLIC_BASE_URL=http://localhost:3000

# URL del frontend
WEB_BASE_URL=http://localhost:5173

# Tasa de referencia, COP por USD
REFERENCE_COP_PER_USD=3900

# Spread en porcentaje
SPREAD_PCT=3

# Tope diario del grant de la tienda, en COP
DAILY_GRANT_LIMIT_COP=2000000

# Flotante objetivo de USDC del operador
USDC_FLOAT=1000

# Ruta del archivo SQLite, relativa al directorio server
DATABASE_PATH=data/walle.sqlite

# Nivel de log: fatal, error, warn, info, debug, trace o silent
LOG_LEVEL=info
